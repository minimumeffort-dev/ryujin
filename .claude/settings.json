{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Ensuring wiki watcher is running",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/tools/run_hook.sh\" ensure_watcher.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Checking extraction queue",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/tools/run_hook.sh\" queue_hook.py claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
