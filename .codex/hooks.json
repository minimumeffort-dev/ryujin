{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Ensuring wiki watcher is running",
            "command": "sh \"$(git rev-parse --show-toplevel)/tools/run_hook.sh\" ensure_watcher.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Recalling wiki knowledge",
            "command": "sh \"$(git rev-parse --show-toplevel)/tools/run_hook.sh\" recall_hook.py codex --hops 2",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Checking extraction queue",
            "command": "sh \"$(git rev-parse --show-toplevel)/tools/run_hook.sh\" queue_hook.py codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
