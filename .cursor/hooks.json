{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "name": "Ensure wiki watcher",
        "command": "sh \"${CURSOR_PROJECT_DIR}/tools/run_hook.sh\" ensure_watcher.py",
        "timeout": 10
      }
    ],
    "workspaceOpen": [
      {
        "name": "Ensure wiki watcher",
        "command": "sh \"${CURSOR_PROJECT_DIR}/tools/run_hook.sh\" ensure_watcher.py",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "name": "Recall wiki knowledge",
        "command": "sh \"${CURSOR_PROJECT_DIR}/tools/run_hook.sh\" recall_hook.py cursor --hops 2",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "name": "Checking extraction queue",
        "command": "sh \"${CURSOR_PROJECT_DIR}/tools/run_hook.sh\" queue_hook.py cursor",
        "timeout": 10,
        "loop_limit": 1
      }
    ]
  }
}
